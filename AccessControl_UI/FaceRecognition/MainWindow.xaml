<!-- 인증 클라이언트 화면입니다. 직원 기준은 자동 동기화하며 최종 출입 판정은 서버 응답으로 표시합니다. -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FaceRecognition.MainWindow"
    Icon="Assets/camera.ico"
    Title="Access Control · 클라이언트"
    Width="1360"
    Height="900"
    MinWidth="1040"
    MinHeight="760"
    Closing="WindowClosing"
    PreviewMouseDown="DismissSettingsMenu"
    PreviewKeyDown="DismissSettingsOnEscape"
    Background="{StaticResource StudioBackground}"
    Foreground="{StaticResource StudioInk}"
    FontFamily="Malgun Gothic"
    FontSize="13">
    <Grid>
        <Border Margin="18" Background="#142033" BorderBrush="{StaticResource StudioLine}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="6,0,6,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE CAMERA" Foreground="White" FontSize="12" VerticalAlignment="Center"/>

                    </StackPanel>
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="OpenSettingsMenu" Width="32" Height="32" Foreground="White" Background="Transparent" BorderThickness="0" ToolTip="클라이언트 설정" ToolTipService.IsEnabled="False" MouseEnter="ShowInlineHint" MouseLeave="HideInlineHint" AutomationProperties.Name="클라이언트 설정 열기" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="20"/>
                    </Button>
                    <ToggleButton x:Name="AnalysisButton" DockPanel.Dock="Right" Width="32" Height="32" Margin="0,0,8,0" Foreground="White" Cursor="Hand" ToolTip="분석 화면 켜기/끄기" ToolTipService.IsEnabled="False" MouseEnter="ShowInlineHint" MouseLeave="HideInlineHint" Click="ToggleAnalysis" AutomationProperties.Name="분석 화면 켜기 끄기">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="SelectionBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#94D9FF"/><Setter TargetName="SelectionBorder" Property="Background" Value="#223C56"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border x:Name="CameraStatusIcon" Background="Transparent" Padding="6" ToolTipService.IsEnabled="False" MouseEnter="ShowInlineHint" MouseLeave="HideInlineHint" AutomationProperties.Name="카메라 연결 상태">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Video24" FontSize="18" Foreground="#D8E2EF" VerticalAlignment="Center"/>
                                <Ellipse x:Name="CameraLight" Width="10" Height="10" Fill="#DC2626" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ServerStatusIcon" Background="Transparent" Padding="6" Margin="8,0,0,0" ToolTipService.IsEnabled="False" MouseEnter="ShowInlineHint" MouseLeave="HideInlineHint" AutomationProperties.Name="서버 연결 상태">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#D8E2EF" VerticalAlignment="Center"/>
                                <Ellipse x:Name="ServerLight" Width="10" Height="10" Fill="#DC2626" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <ContentControl x:Name="AiHost" Grid.Row="1"/>
                <!-- 창 밖으로 뜨는 네이티브 팝업 대신 카메라 내부에 메뉴와 설명을 배치합니다. -->
                <Border x:Name="SettingsMenu" Grid.Row="1" Panel.ZIndex="20" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F8FAFC" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="6" Padding="4" Width="172" Margin="0,0,6,0">
                    <StackPanel>
                        <Button Content="서버 연결" Tag="0" Click="OpenSettingsSection" Padding="12,9" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                        <Button Content="카메라·AI" Tag="1" Click="OpenSettingsSection" Padding="12,9" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                        <Button Content="녹화·보관" Tag="2" Click="OpenSettingsSection" Padding="12,9" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border x:Name="InlineHint" Grid.Row="1" Panel.ZIndex="21" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,6,0" MaxWidth="460" Background="#F8FAFC" CornerRadius="4" Padding="10,7">
                    <TextBlock x:Name="InlineHintText" TextWrapping="Wrap" Foreground="#17283F" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <!-- 기존 상태 바인딩과 인증 처리는 유지하되 중복 안내 영역은 주 화면에서 표시하지 않습니다. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="Clock"/>
            <RadioButton x:Name="NavLive"/>
            <TextBlock x:Name="CameraConnection"/>
            <TextBlock x:Name="ServerConnection"/>
            <TextBlock x:Name="AiConnection"/>
            <TextBlock x:Name="GalleryConnection"/>
            <TextBlock x:Name="ReferenceSummary"/>
            <TextBlock x:Name="LiveIndicator"/>
            <Border x:Name="AccessCard"><TextBlock x:Name="AccessStatus"/></Border>
            <ListBox x:Name="RecentEvents" SelectionChanged="SelectRecentEvent"/>
        </StackPanel>
        <Grid x:Name="AuxiliaryViews" Visibility="Collapsed">
            <StackPanel x:Name="ConnectionControls" Margin="8">
                <TextBlock Text="최초 한 번 등록하면 다음 실행부터 자동 연결합니다. 카메라는 카메라·AI 설정에서 직접 시작하며, 카메라 시작 시 녹화도 시작됩니다." TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="서버에서 복사한 연결 코드"/>
                <PasswordBox x:Name="PairingCode" Margin="0,8,0,8"/>
                <ui:Button x:Name="ApplyPair" Content="연결 코드 적용" Click="ApplyPairing" Margin="0,0,0,16"/>
                <TextBlock Text="서버 주소" Style="{StaticResource StudioCaption}"/>
                <TextBox x:Name="TcpHost" IsReadOnly="True" Text="연결 코드 적용 필요" Margin="0,4,0,8"/>
                <TextBlock Text="TCP 포트" Margin="0,12,0,4"/>
                <TextBox x:Name="TcpPort" IsReadOnly="True" Text="5050" Margin="0,4,0,8"/>
                <WrapPanel Margin="0,12,0,0">
                    <ui:Button
                        x:Name="TcpConnect"
                        Content="서버 연결"
                        Appearance="Primary"
                        Click="ConnectServer"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,10,8" />
                    <ui:Button
                        x:Name="TcpDisconnect"
                        Content="인증·영상 연결 종료"
                        Appearance="Secondary"
                        Margin="0,0,0,8"
                        Click="DisconnectServer"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch" />
                </WrapPanel>
                <TextBlock
                    x:Name="GalleryStatus"
                    Text="서버 연결 후 직원 기준 자동 동기화"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                    Foreground="{StaticResource StudioMuted}" />
                <TextBlock
                    x:Name="TcpStatus"
                    Text="서버 미연결"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                    Foreground="{StaticResource StudioMuted}" />
            </StackPanel>
            <StackPanel x:Name="RecordingControls" Margin="8">
                <TextBlock x:Name="RecordingStatus" Text="카메라 연결 후 자동 녹화" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock
                    x:Name="RetentionStatus"
                    Text="원본 보관 72시간 · 확인 대기"
                    Style="{StaticResource StudioCaption}"
                    Margin="0,0,0,8" />
                <ui:Button Content="녹화 폴더 열기" Appearance="Secondary" Click="OpenRecordingFolder" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
