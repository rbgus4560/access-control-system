<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Ui/*.cs" Link="Ui/%(Filename)%(Extension)"/>
        <PackageReference Include="WPF-UI" Version="4.3.0"/>
        <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)"/>
        <Compile Include="../Network/*.cs" Link="Network/%(Filename)%(Extension)"/>
        <Compile Include="../FaceService/*.cs" Link="FaceService/%(Filename)%(Extension)"/>
    </ItemGroup>
</Project>
