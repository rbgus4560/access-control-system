<!-- 인증 클라이언트 화면입니다. 직원 기준은 자동 동기화하며 최종 출입 판정은 서버 응답으로 표시합니다. -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FaceRecognition.SettingsWindow"
    Icon="Assets/camera.ico"
    Title="클라이언트 설정 · 서버·카메라·녹화"
    Width="640"
    Height="560"
    MinWidth="560"
    MinHeight="460"
    WindowStartupLocation="CenterOwner"
    FontFamily="Malgun Gothic"
    Background="{StaticResource StudioBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="SectionTitle" Text="서버 연결" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="창을 닫아도 카메라·AI·서버 연결과 녹화는 계속됩니다." Style="{StaticResource StudioCaption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid x:Name="Section0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="ConnectionHost" Margin="12"/>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="Section1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="CameraHost" Margin="12"/>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="Section2" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="녹화 및 보관 상태" Style="{StaticResource StudioHeading}"/>
                        <ContentControl x:Name="RecordingHost"/>
                        <Separator/>
                        <TextBlock
                            Text="완료 원본은 구간 종료 후 72시간 보관합니다. 재생·클립 추출 중인 원본은 정리를 보류합니다. 서버로 수신이 확인된 임시 클립은 정리하며, 서버 사본은 별도로 보관합니다."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="여유 공간 20GB 미만이면 새 녹화를 중단합니다. 서버 단절 중에는 새 출입 허가를 중단하고, 켜져 있는 인증 앱의 로컬 녹화는 계속합니다."
                            TextWrapping="Wrap"
                            Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
