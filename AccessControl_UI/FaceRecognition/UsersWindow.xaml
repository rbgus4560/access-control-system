<!-- 인증 클라이언트 화면입니다. 직원 기준은 자동 동기화하며 최종 출입 판정은 서버 응답으로 표시합니다. -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="FaceRecognition.UsersWindow"
    Title="인증 기준 선택 · 읽기 전용"
    Width="1000"
    Height="800"
    MinWidth="800"
    MinHeight="650"
    WindowStartupLocation="CenterOwner"
    FontFamily="Malgun Gothic"
    Background="{StaticResource StudioBackground}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="인증 기준 선택" FontSize="25" FontWeight="Bold"/>
            <TextBlock
                Text="서버에 등록된 직원 한 명을 선택해 비교 기준을 불러옵니다. 직원 정보·권한·얼굴 등록은 관리 서버에서 수정합니다."
                Style="{StaticResource StudioCaption}"
                Margin="0,5,0,12" />
            <WrapPanel>
                <TextBox x:Name="Search" Width="240" Margin="0,0,10,0"/>
                <ui:Button Content="이름·사원번호 검색" Appearance="Secondary" Click="Filter" Margin="0,0,8,0"/>
                <ui:Button x:Name="ReloadButton" Content="목록 새로고침" Appearance="Secondary" Click="Reload" Margin="0,0,8,0"/>
            </WrapPanel>
            <TextBlock x:Name="Status" Text="서버 DB 연결 후 목록을 조회하세요." TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource StudioCard}" Padding="4">
            <DataGrid
                x:Name="Users"
                IsReadOnly="True"
                SelectionChanged="SelectEmployee"
                AutoGenerateColumns="False"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="사원번호" Binding="{Binding EmployeeNo}" Width="130"/>
                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                    <DataGridCheckBoxColumn Header="활성" Binding="{Binding Active,Mode=OneWay}" Width="70"/>
                    <DataGridCheckBoxColumn Header="출입 허용" Binding="{Binding AccessEnabled,Mode=OneWay}" Width="90"/>
                    <DataGridTemplateColumn Header="얼굴 등록" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="등록됨"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EnrollmentId}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="미등록"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource StudioCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="인증에 사용할 얼굴 기준" Style="{StaticResource StudioHeading}"/>
                <ContentControl x:Name="ReferenceHost"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
