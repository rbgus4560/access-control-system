<!-- 관리 서버 화면입니다. 관제·직원 관리·DB/장치 설정과 목록 창의 배치를 정의합니다. -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AccessControlServer.MainWindow"
    Icon="Assets/camera.ico"
    Title="Access Control · 서버"
    Closing="WindowClosing"
    Width="1440"
    Height="940"
    MinWidth="1120"
    MinHeight="800"
    Background="{StaticResource StudioBackground}"
    Foreground="{StaticResource StudioInk}"
    FontFamily="Malgun Gothic"
    FontSize="13">
    <Window.Resources>
        <Style x:Key="BareIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerNavItem" TargetType="RadioButton" BasedOn="{StaticResource FlatNavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=Sidebar}" Value="Collapsed">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#2563EB"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CameraListButton" TargetType="Button">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavGroup" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Border x:Name="GroupFrame" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Background="Transparent" ClipToBounds="True">
                    <StackPanel>
                        <ToggleButton x:Name="GroupHeader" Background="Transparent" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" BorderThickness="0">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="7,10"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border></ControlTemplate></ToggleButton.Template>
                            <ContentPresenter ContentSource="Header"/>
                            <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, ElementName=Sidebar}" Value="Collapsed"><Setter Property="HorizontalContentAlignment" Value="Center"/></DataTrigger>
                            </Style.Triggers></Style></ToggleButton.Style>
                        </ToggleButton>
                        <ContentPresenter x:Name="Items" ContentSource="Content" Visibility="Collapsed" Margin="0,3"/>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="Items" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="GroupFrame" Property="BorderBrush" Value="#DCE3ED"/>
                    <Setter TargetName="GroupFrame" Property="Background" Value="White"/>
                    <Setter TargetName="GroupHeader" Property="Background" Value="#F0F3F8"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="White" BorderBrush="{StaticResource StudioLine}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarLayout" Margin="12,18,12,18">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Tag="SidebarLabel" Text="서버관제" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,32,0"/>
                        <Button x:Name="SidebarToggle" Style="{StaticResource BareIconButton}" Click="ToggleSidebar" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4" ToolTip="메뉴 접기" AutomationProperties.Name="메뉴 접기">
                            <Grid Width="16" Height="14">
                                <Border BorderBrush="#526078" BorderThickness="1" CornerRadius="2"/>
                                <Border Width="1" Background="#526078" HorizontalAlignment="Left" Margin="5,1,0,1"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <Expander x:Name="CamerasMenu" Style="{StaticResource NavGroup}" IsExpanded="False" Expanded="AnimateMenu" Margin="0,4,0,0">
                        <Expander.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Tag="SidebarIcon" Symbol="Video24" FontSize="19" Margin="0,0,10,0"/><TextBlock Tag="SidebarLabel" Text="서버관제" FontWeight="SemiBold"/></StackPanel></Expander.Header>
                        <StackPanel>
                            <StackPanel x:Name="CameraList"/>
                        </StackPanel>
                    </Expander>
                    <RadioButton x:Name="NavLive" Visibility="Collapsed"/>
                    <Expander x:Name="EmployeesMenu" Style="{StaticResource NavGroup}" IsExpanded="False" Expanded="AnimateMenu" Margin="0,12,0,0">
                        <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,10,0" Tag="SidebarIcon"/><TextBlock Tag="SidebarLabel" Text="직원 관리" FontWeight="SemiBold"/></StackPanel></Expander.Header>
                        <StackPanel>                    <RadioButton Style="{StaticResource ServerNavItem}" GroupName="MainNav" AutomationProperties.Name="직원·출입 권한" Click="ShowEmployees">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Tag="SidebarIcon" Symbol="Person24" FontSize="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Tag="SidebarLabel" Text="직원·출입 권한" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ServerNavItem}" GroupName="MainNav" AutomationProperties.Name="얼굴 등록" Click="ShowEnrollment">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Tag="SidebarIcon" Symbol="PersonAdd24" FontSize="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Tag="SidebarLabel" Text="얼굴 등록" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="RecordsMenu" Style="{StaticResource NavGroup}" IsExpanded="False" Expanded="AnimateMenu" Margin="0,12,0,0">
                        <Expander.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Folder24" FontSize="19" Margin="0,0,10,0" Tag="SidebarIcon"/><TextBlock Tag="SidebarLabel" Text="기록 및 영상" FontWeight="SemiBold"/></StackPanel></Expander.Header>
                        <StackPanel>                    <RadioButton Style="{StaticResource ServerNavItem}" GroupName="MainNav" AutomationProperties.Name="출입 기록" Click="ShowHistory">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Tag="SidebarIcon" Symbol="Document24" FontSize="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Tag="SidebarLabel" Text="출입 기록" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ServerNavItem}" GroupName="MainNav" AutomationProperties.Name="타임라인·클립" Click="ShowTimeline">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Tag="SidebarIcon" Symbol="Video24" FontSize="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Tag="SidebarLabel" Text="영상 조회·클립" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <RadioButton Style="{StaticResource ServerNavItem}" GroupName="MainNav" AutomationProperties.Name="서버 설정" Click="ShowServerSettings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Tag="SidebarIcon" Symbol="Settings24" FontSize="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Tag="SidebarLabel" Text="서버 설정" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Separator/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>
            <Border Background="#142033" Padding="8,2" Margin="0,0,0,0">
                <Grid>
                <TextBlock x:Name="PlacementHint" Text="카메라 선택 후 배치할 화면을 클릭하세요" Foreground="#A8B9CD" VerticalAlignment="Center" Margin="4,0,160,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="DbStatusIcon" ToolTipService.IsEnabled="False" MouseEnter="ShowStatusHint" MouseLeave="HideStatusHint" Padding="8,5" Background="Transparent" AutomationProperties.Name="DB 연결 상태">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Database24" FontSize="18" Foreground="#D8E2EF"/>
                            <Ellipse x:Name="DbLight" Width="8" Height="8" Fill="Firebrick" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TcpStatusIcon" ToolTipService.IsEnabled="False" MouseEnter="ShowStatusHint" MouseLeave="HideStatusHint" Padding="8,5" Background="Transparent" AutomationProperties.Name="TCP IP 수신 상태">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#D8E2EF"/>
                            <Ellipse x:Name="TcpLight" Width="8" Height="8" Fill="Firebrick" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StreamStatusIcon" ToolTipService.IsEnabled="False" MouseEnter="ShowStatusHint" MouseLeave="HideStatusHint" Padding="8,5" Background="Transparent" AutomationProperties.Name="영상 수신 상태">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Video24" FontSize="18" Foreground="#D8E2EF"/>
                            <Ellipse x:Name="StreamLight" Width="8" Height="8" Fill="Firebrick" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <UniformGrid x:Name="CameraGrid" Rows="3" Columns="3"/>
                <Border x:Name="StatusHint" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="400" Margin="0,4,6,0" Background="#F8FAFC" Padding="10,7" CornerRadius="4">
                    <TextBlock x:Name="StatusHintText" TextWrapping="Wrap" Foreground="#17283F"/>
                </Border>
            </Grid>
            <!-- 주 화면에서 숨긴 보조 상태는 기존 갱신 처리를 위해 유지합니다. -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="ServerClock"/>
                <TextBlock x:Name="DashboardStatus"/>
                <TextBlock x:Name="DbIndicator"/>
                <TextBlock x:Name="TcpIndicator"/>
                <TextBlock x:Name="StreamIndicator"/>
                <Image x:Name="ServerVideo"/>
                <StackPanel x:Name="VideoHint"/>
                <TextBlock x:Name="VideoStatus"/>
                <TextBlock x:Name="DoorResult"/>
                <TextBlock x:Name="TcpClientStatus"/>
                <TextBlock x:Name="LiveResult"/>
                <TextBlock x:Name="LiveSummary"/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource StudioCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="전체 기록" Appearance="Secondary" Click="ShowHistory" Padding="10,5"/>
                        <StackPanel>

                            <TextBlock
                                x:Name="RecentStatus"
                                Text="DB 조회 또는 새 판정 수신 후 표시됩니다."
                                Style="{StaticResource StudioCaption}"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid
                        x:Name="RecentPreview"
                        Grid.Row="1"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        SelectionMode="Single"
                        SelectionChanged="OpenRecentDetail">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding 시각}" Width="*"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding 이름}" Width="*"/>
                            <DataGridTextColumn Header="결과" Binding="{Binding 결과}" Width="*"/>
                            <DataGridTextColumn Header="사유" Binding="{Binding 사유}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="AuxiliaryViews" Visibility="Collapsed">
            <TabControl x:Name="SettingsControls">
                <TabItem Header="DB·관리자">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="DB 연결 및 관리자" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="DB에 한 번 연결하면 직원 관리·출입 기록·영상 조회에서 함께 사용합니다. 연결 성공 후 TCP 수신을 자동 시작합니다." Style="{StaticResource StudioCaption}" Margin="0,0,0,20"/>
                            <WrapPanel x:Name="ConnectionFields" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="호스트" Style="{StaticResource StudioCaption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="HostInput" Text="127.0.0.1" Width="120"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="포트" Style="{StaticResource StudioCaption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PortInput" Text="5432" Width="65"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="DB 이름" Style="{StaticResource StudioCaption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DatabaseInput" Text="access_control_system" Width="190"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="계정" Style="{StaticResource StudioCaption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="UsernameInput" Text="postgres" Width="100"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,6">
                                    <TextBlock Text="DB 비밀번호" Style="{StaticResource StudioCaption}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="PasswordInput" Width="155"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,10">
                                <ui:Button
                                    x:Name="LoadButton"
                                    Content="DB 연결 및 목록 조회"
                                    Appearance="Primary"
                                    Click="LoadDatabase"
                                    Margin="0,0,8,0" />
                                <ui:Button Content="DB 연결 해제" Appearance="Secondary" Click="ClearDatabase" Margin="0,0,12,0"/>
                                <TextBlock x:Name="DbStatus" Text="PostgreSQL · 미확인" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </WrapPanel>
                            <CheckBox x:Name="RememberConnection"
                                Content="이 Windows 계정에 암호화 저장하고 다음 실행 시 DB 자동 연결"
                                Unchecked="ForgetStartupSettings" Margin="0,4,0,16"/>
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="얼굴 등록 관리자" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="FaceAdmins" Width="240" SelectionChanged="SelectAdmin" VerticalContentAlignment="Center"/>
                                <ui:Button Content="관리자 추가" Appearance="Secondary" Click="AddAdmin" Margin="10,0"/>
                                <TextBlock x:Name="FaceDbStatus" Text="직원·얼굴 서비스 미연결" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="클라이언트 연결">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="클라이언트 접속 설정" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="서버의 LAN 주소를 선택하고 수신을 시작한 뒤 연결 코드를 클라이언트에 전달하세요."
                                Style="{StaticResource StudioCaption}"
                                Margin="0,8,0,20" />
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="서버 IPv4" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ServerAddress" Width="180" IsEditable="True" Margin="8,0"/>
                                <ui:Button Content="클라이언트 연결 코드 복사" Click="CopyPairing"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="LAN TLS · 기본 포트 :" VerticalAlignment="Center"/>
                                <TextBox x:Name="TcpPort" Text="5050" Width="65" VerticalContentAlignment="Center" Margin="8,0"/>
                                <ui:Button x:Name="TcpStart" Content="TCP 서버 시작" Appearance="Primary" Click="StartTcp" Margin="0,0,8,0"/>
                                <ui:Button
                                    x:Name="TcpStop"
                                    Content="서버 중지"
                                    Appearance="Secondary"
                                    Click="StopTcp"
                                    IsEnabled="False"
                                    Margin="0,0,12,0" />
                                <TextBlock x:Name="TcpStatus" Text="TCP 서버 중지" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="등록 장치">
                    <StackPanel Margin="20">
                        <TextBlock Text="DB 등록 장치" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        <TabControl Height="330">
                            <TabItem Header="클라이언트">
                                <DataGrid x:Name="Clients"/>
                            </TabItem>
                            <TabItem Header="카메라">
                                <DataGrid x:Name="Cameras"/>
                            </TabItem>
                        </TabControl>
                        <TextBlock x:Name="DeviceCount" Text="조회 전" Margin="0,8,0,0"/>
                        <TextBlock Text="DB 등록 상태이며 실제 연결 상태와 다를 수 있습니다." Style="{StaticResource StudioCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <Grid x:Name="HistoryControls" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="HistoryFrom" Width="155" Language="ko-KR" SelectedDateFormat="Short"/>
                        <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                        <DatePicker x:Name="HistoryUntil" Width="155" Language="ko-KR" SelectedDateFormat="Short"/>
                        <TextBlock Text="검색" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="HistorySearch" Width="180" Padding="6,4" VerticalContentAlignment="Center" AutomationProperties.Name="출입 기록 검색"/>
                        <ui:Button x:Name="HistoryRefresh" Content="기록 조회" Appearance="Secondary" Click="RefreshHistory" Margin="8,0,6,0"/>
                        <ui:Button x:Name="EventPlaybackButton" Content="선택 기록 영상" Icon="{ui:SymbolIcon Video24}" Appearance="Secondary" Click="PlaySelectedEvent" Margin="0,0,6,0"/>
                        <ui:Button Content="이벤트 상세" Appearance="Secondary" Click="ShowDetail"/>
                        <TextBlock x:Name="HistoryStatus" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
                <DataGrid x:Name="Events" Grid.Row="1" SelectionMode="Single" MouseDoubleClick="DoubleClickEvent"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
