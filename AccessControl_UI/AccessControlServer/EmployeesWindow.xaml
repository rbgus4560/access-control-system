<!-- 관리 서버 화면입니다. 관제·직원 관리·DB/장치 설정과 목록 창의 배치를 정의합니다. -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="AccessControlServer.EmployeesWindow"
    Title="직원·출입 권한 관리 · 서버"
    Width="1200"
    Height="840"
    MinWidth="1080"
    MinHeight="800"
    WindowStartupLocation="CenterOwner"
    FontFamily="Malgun Gothic"
    Background="{StaticResource StudioBackground}"
    Foreground="{StaticResource StudioInk}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="직원·출입 권한 관리" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="EndpointLabel" Visibility="Collapsed"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource StudioCard}" Padding="14,10" Margin="0,12,0,16">
        <StackPanel x:Name="SearchArea" Orientation="Horizontal">
            <TextBlock Text="직원 검색" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="SearchInput" Width="300" Margin="0,0,12,0" ToolTip="사원번호 또는 이름"/>
            <ui:Button Appearance="Secondary" Content="검색·새로고침" Click="Search" Margin="0,0,8,0"/>
        </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <DataGrid
                x:Name="Employees"
                Margin="0,0,20,0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionChanged="SelectEmployee">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="사원번호" Binding="{Binding EmployeeNo}" Width="*"/>
                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="부서" Binding="{Binding Department}" Width="*"/>
                    <DataGridTextColumn Header="직급" Binding="{Binding Position}" Width="*"/>
                    <DataGridCheckBoxColumn Header="활성" Binding="{Binding IsActive}" Width="*"/>
                    <DataGridCheckBoxColumn Header="출입 허용" Binding="{Binding AccessEnabled}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Style="{StaticResource StudioCard}" Padding="18">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="EditArea" Margin="0,0,16,0">
                    <TextBlock x:Name="EditTitle" Text="신규 직원" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="사원번호 필수"/>
                    <TextBox x:Name="EmployeeNoInput" MaxLength="100"/>
                    <TextBlock Text="이름 필수"/>
                    <TextBox x:Name="NameInput" MaxLength="100"/>
                    <TextBlock Text="부서 선택"/>
                    <TextBox x:Name="DepartmentInput" MaxLength="100"/>
                    <TextBlock Text="직급 선택"/>
                    <TextBox x:Name="PositionInput" MaxLength="100"/>
                    <CheckBox x:Name="ActiveInput" Content="활성 직원" IsChecked="True" Margin="0,10,0,6"/>
                    <CheckBox x:Name="AccessInput" Content="출입 허용" IsChecked="False" Margin="0,0,0,10"/>

                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="DeletionLabel" Visibility="Collapsed" Foreground="#B45309" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <ui:Button Appearance="Primary" x:Name="SaveButton" Content="신규 직원 저장" Click="SaveEmployee" HorizontalAlignment="Stretch"/>
                <ui:Button x:Name="RestoreButton" Content="정보 복원" Click="RestoreEmployee" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                <ui:Button x:Name="DeleteButton" Content="직원 삭제" Click="DeleteEmployee" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                <TextBlock x:Name="UpdatedLabel" Visibility="Collapsed"/>
            </StackPanel>
            </Grid>
            </Border>
        </Grid>
        <TextBlock
            x:Name="StatusLabel"
            Visibility="Collapsed"
            Grid.Row="3"
            Text="서버의 DB 연결을 사용합니다. 직원 목록을 불러오는 중입니다."
            TextWrapping="Wrap"
            Margin="0,16,0,0" />
    </Grid>
</Window>
